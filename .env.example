# =========================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO LOCALES
# =========================================================================
# Copia este archivo como .env y edita sus valores:
# cp .env.example .env (o Copy-Item .env.example .env en PowerShell)
# =========================================================================

# Puerto del microservicio FastAPI
PORT=8000

# Ruta local del modelo entrenado
MODEL_PATH=models/best_model.pkl

# =========================================================================
# CONFIGURACIÓN CON DAGSHUB (MLflow Remoto y Model Registry)
# =========================================================================
# MLFLOW_TRACKING_URI=https://dagshub.com/<TU_USUARIO>/<TU_REPO>.mlflow
# MLFLOW_TRACKING_USERNAME=<TU_USUARIO>
# MLFLOW_TRACKING_PASSWORD=<TU_TOKEN_DAGSHUB>

# Puntero para Serving: puede ser un Run ID o el Model Registry de DagsHub:
# MLFLOW_MODEL_URI=models:/customer_churn_model/1
# MLFLOW_MODEL_URI=runs:/<RUN_ID>/model

# =========================================================================
